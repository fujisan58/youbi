import sys
import datetime

days = ["月曜日", "火曜日", "水曜日", "木曜日","金曜日","土曜日","日曜日"]

def show(text):
    date = datetime.datetime.strptime(text, "%Y-%m-%d")
    number = date.weekday()
    print(date.strftime("%Y-%m-%d"), days[number])


if len(sys.argv) > 1:
    show(sys.argv[1])
else:
    for line in sys.stdin:
        show(line.strip())
