import sys
import datetime
import re

days = ["月曜日", "火曜日", "水曜日", "木曜日","金曜日","土曜日","日曜日"]

def convert(text):
    m = re.fullmatch(r"令和(\d+)年(\d+)月(\d+)日", text)
    if m is None:
        return text
    year = int(m.group(1)) + 2018
    month = int(m.group(2))
    day = int(m.group(3))
    return "{}-{}-{}".format(year, month, day)

def show(text):
    text = text.replace("/", "-")
    text = convert(text)
    try:
        date = datetime.datetime.strptime(text, "%Y-%m-%d")
    except ValueError:
        print("日付の形が違う:", text, file=sys.stderr)
        return 1
    number = date.weekday()
    print(date.strftime("%Y-%m-%d"), days[number])
    return 0


status = 0
if len(sys.argv) > 1:
    status = show(sys.argv[1])
else:
    for line in sys.stdin:
        if show(line.strip()) != 0:
            status = 1

sys.exit(status)
