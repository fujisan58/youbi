import sys
import datetime

days = ["月曜日", "火曜日", "水曜日", "木曜日","金曜日","土曜日","日曜日"]

date = datetime.datetime.strptime(sys.argv[1], "%Y-%m-%d")
number = date.weekday()
print(date.strftime("%Y-%m-%d"), days[number])
